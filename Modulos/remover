#!/bin/bash
#====================================================
#   Eliminar usuario SSH
#====================================================
remove_ovp() {
    if [[ -e /etc/debian_version ]]; then
        GROUPNAME=nogroup
    fi
    user="$1"
    cd /etc/openvpn/easy-rsa/
    ./easyrsa --batch revoke $user
    ./easyrsa gen-crl
    rm -rf pki/reqs/$user.req
    rm -rf pki/private/$user.key
    rm -rf pki/issued/$user.crt
    rm -rf /etc/openvpn/crl.pem
    cp /etc/openvpn/easy-rsa/pki/crl.pem /etc/openvpn/crl.pem
    chown nobody:$GROUPNAME /etc/openvpn/crl.pem
    [[ -e $HOME/$user.ovpn ]] && rm -f $HOME/$user.ovpn >/dev/null 2>&1
    [[ -e /var/www/html/openvpn/$user.zip ]] && rm -f /var/www/html/openvpn/$user.zip >/dev/null 2>&1
} >/dev/null 2>&1

database="/etc/SSHPlus/usuarios.db"
clear
echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
echo -e "\033[0;34m║\033[0m\033[1;37m            \033[1;36mELIMINAR USUARIO SSH\033[1;37m                  \033[0;34m║\033[0m"
echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
echo ""
echo -e "  \033[1;36m01\033[0m) \033[1;37mEliminar un usuario\033[0m"
echo -e "  \033[1;36m02\033[0m) \033[1;37mEliminar todos los usuarios\033[0m"
echo -e "  \033[1;36m00\033[0m) \033[1;32m‹ Volver\033[0m"
echo ""
echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
echo -ne "  \033[1;32m¿Qué deseas hacer?\033[0m "
read -e -i 1 resp

if [[ "$resp" = "1" || "$resp" = "01" ]]; then
    clear
    echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
    echo -e "\033[0;34m║\033[0m\033[1;37m            \033[1;36mELIMINAR USUARIO SSH\033[1;37m                  \033[0;34m║\033[0m"
    echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
    echo ""
    echo -e "  \033[1;33mLista de usuarios:\033[0m"
    echo ""
    _userT=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody)
    i=0
    unset _userPass
    while read _user; do
        i=$(expr $i + 1)
        _oP=$i
        [[ $i == [1-9] ]] && i=0$i && oP+=" 0$i"
        echo -e "  \033[1;36m$i\033[0m) \033[1;37m$_user\033[0m"
        _userPass+="\n${_oP}:${_user}"
    done <<< "${_userT}"
    echo ""
    num_user=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)
    echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
    echo -ne "  \033[1;32mIngresa o selecciona un usuario\033[0m \033[1;33m[\033[1;36m1\033[0m-\033[1;36m$num_user\033[1;33m]\033[0m: "
    read option
    user=$(echo -e "${_userPass}" | grep -E "\b$option\b" | cut -d: -f2)
    if [[ -z $option ]]; then
        echo ""
        echo -e "  \033[1;31mUsuario vacío o no válido.\033[0m"
        echo ""
        exit 1
    elif [[ -z $user ]]; then
        echo ""
        echo -e "  \033[1;31mNombre de usuario vacío o no válido.\033[0m"
        echo ""
        exit 1
    else
        if cat /etc/passwd | grep -w $user >/dev/null; then
            echo ""
            pkill -f "$user" >/dev/null 2>&1
            deluser --force $user >/dev/null 2>&1
            echo -e "  \033[1;32m✓ Usuario $user eliminado correctamente.\033[0m"
            grep -v ^$user[[:space:]] /etc/SSHPlus/usuarios.db >/tmp/ph
            cat /tmp/ph >/etc/SSHPlus/usuarios.db
            rm -f /etc/SSHPlus/senha/$user >/dev/null 2>&1
            if [[ -e /etc/openvpn/server.conf ]]; then
                remove_ovp $user
            fi
            echo ""
            exit 0
        elif [[ "$(cat "$database" | grep -w $user | wc -l)" -ne "0" ]]; then
            ps x | grep $user | grep -v grep | grep -v pt >/tmp/rem
            if [[ $(grep -c $user /tmp/rem) -eq 0 ]]; then
                deluser --force $user >/dev/null 2>&1
                echo ""
                echo -e "  \033[1;32m✓ Usuario $user eliminado correctamente.\033[0m"
                grep -v ^$user[[:space:]] /etc/SSHPlus/usuarios.db >/tmp/ph
                cat /tmp/ph >/etc/SSHPlus/usuarios.db
                rm -f /etc/SSHPlus/senha/$user >/dev/null 2>&1
                if [[ -e /etc/openvpn/server.conf ]]; then
                    remove_ovp $user
                fi
                echo ""
                exit 0
            else
                echo ""
                echo -e "  \033[1;33mUsuario conectado. Desconectando...\033[0m"
                pkill -f "$user" >/dev/null 2>&1
                deluser --force $user >/dev/null 2>&1
                echo -e "  \033[1;32m✓ Usuario $user eliminado correctamente.\033[0m"
                grep -v ^$user[[:space:]] /etc/SSHPlus/usuarios.db >/tmp/ph
                cat /tmp/ph >/etc/SSHPlus/usuarios.db
                rm -f /etc/SSHPlus/senha/$user >/dev/null 2>&1
                if [[ -e /etc/openvpn/server.conf ]]; then
                    remove_ovp $user
                fi
                echo ""
                exit 0
            fi
        else
            echo ""
            echo -e "  \033[1;31mEl usuario $user no existe.\033[0m"
            echo ""
        fi
    fi
elif [[ "$resp" = "2" || "$resp" = "02" ]]; then
    clear
    echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
    echo -e "\033[0;34m║\033[0m\033[1;37m         \033[1;31mELIMINAR TODOS LOS USUARIOS\033[1;37m              \033[0;34m║\033[0m"
    echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
    echo ""
    echo -ne "  \033[1;33m¿Realmente deseas eliminar TODOS los usuarios?\033[0m \033[1;37m[s/n]:\033[0m "
    read opc
    if [[ "$opc" = "s" || "$opc" = "S" ]]; then
        echo -e "\n  \033[1;33mEspera...\033[0m"
        for user in $(cat /etc/passwd | awk -F : '$3 > 900 {print $1}' | grep -vi "nobody"); do
            pkill -f $user >/dev/null 2>&1
            deluser --force $user >/dev/null 2>&1
            if [[ -e /etc/openvpn/server.conf ]]; then
                remove_ovp $user
            fi
        done
        rm -f /etc/SSHPlus/usuarios.db && touch /etc/SSHPlus/usuarios.db
        rm -f *.zip >/dev/null 2>&1
        echo -e "\n  \033[1;32m✓ Usuarios eliminados correctamente.\033[0m"
        sleep 2
        menu
    else
        echo -e "\n  \033[1;31mVolviendo al menú...\033[0m"
        sleep 2
        menu
    fi
elif [[ "$resp" = "0" || "$resp" = "00" || "$resp" = "3" ]]; then
    menu
else
    echo -e "\n  \033[1;31mOpción no válida.\033[0m"
    sleep 1.5
    menu
fi
