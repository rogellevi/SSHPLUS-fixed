#!/bin/bash
clear
echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
echo -e "\033[0;34m║\033[0m\033[1;37m          \033[1;36mCAMBIAR LÍMITE DE CONEXIONES\033[1;37m            \033[0;34m║\033[0m"
echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
echo ""

database="/etc/SSHPlus/usuarios.db"

if [[ ! -f "$database" ]]; then
    echo -e "  \033[1;31mNo se encontró el archivo $database\033[0m"
    echo ""
    exit 1
fi

echo -e "  \033[1;33mLista de usuarios y sus límites:\033[0m"
echo ""
echo -e "  \033[1;36mNº\033[0m   \033[1;36mUsuario\033[0m               \033[1;36mLímite\033[0m"
echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"

_userT=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody)
i=0
unset _userPass

while read -r _user; do
    i=$((i + 1))
    _oP=$i
    num=$(printf "%02d" $i)

    if [[ "$(grep -wc "$_user" "$database")" != "0" ]]; then
        limit=$(grep -w "$_user" "$database" | cut -d' ' -f2)
    else
        limit='1'
    fi

    printf "  \033[1;36m%s\033[0m)  \033[1;37m%-22s\033[0m  \033[1;33m%s\033[0m\n" "$num" "$_user" "$limit"
    _userPass+="\n${_oP}:${_user}"
done <<< "${_userT}"

echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
echo ""

num_user=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)
echo -ne "  \033[1;32mSelecciona un usuario\033[0m \033[1;33m[1-$num_user]\033[0m: "
read -r option

usuario=$(echo -e "${_userPass}" | grep -E "\b$option\b" | cut -d: -f2)

if [[ -z "$option" ]] || [[ -z "$usuario" ]]; then
    echo ""
    echo -e "  \033[1;31mUsuario vacío o no existente.\033[0m"
    echo ""
    exit 1
fi

if ! grep -qw "$usuario" /etc/passwd; then
    echo ""
    echo -e "  \033[1;31mEl usuario $usuario no fue encontrado.\033[0m"
    echo ""
    exit 1
fi

echo -ne "\n  \033[1;32mNuevo límite para\033[0m \033[1;33m$usuario\033[0m: "
read -r sshnum

if [[ -z "$sshnum" ]] || ! [[ "$sshnum" =~ ^[0-9]+$ ]] || [[ "$sshnum" -lt 1 ]]; then
    echo ""
    echo -e "  \033[1;31mDebes ingresar un número válido mayor que cero.\033[0m"
    echo ""
    exit 1
fi

grep -v "^${usuario}[[:space:]]" "$database" > /tmp/a
mv /tmp/a "$database"
echo "$usuario $sshnum" >> "$database"

echo ""
echo -e "  \033[1;32m✓ Límite de\033[0m \033[1;33m$usuario\033[0m \033[1;32maplicado:\033[0m \033[1;37m$sshnum\033[0m"
echo ""
sleep 2
