#!/bin/bash
clear

chk=$(grep Banner /etc/ssh/sshd_config 2>/dev/null)
[[ $(netstat -nltp 2>/dev/null | grep -c 'dropbear') != '0' ]] && {
    local="/etc/bannerssh"
    [[ $(grep -wc "$local" /etc/default/dropbear 2>/dev/null) = '0' ]] && echo 'DROPBEAR_BANNER="/etc/bannerssh"' >> /etc/default/dropbear
}
if [[ "$(echo "$chk" | grep -v '#Banner' | grep Banner)" != "" ]]; then
    local=$(echo "$chk" | grep -v "#Banner" | grep Banner | awk '{print $2}')
else
    local="/etc/bannerssh"
    [[ $(grep -wc "$local" /etc/ssh/sshd_config 2>/dev/null) = '0' ]] && echo "Banner /etc/bannerssh" >> /etc/ssh/sshd_config
fi

echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
echo -e "\033[0;34m║\033[0m\033[1;37m                 \033[1;36mBANNER\033[1;37m                           \033[0;34m║\033[0m"
echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
echo ""
echo -e "  \033[1;36m01\033[0m) \033[1;37mAgregar banner\033[0m"
echo -e "  \033[1;36m02\033[0m) \033[1;37mEliminar banner\033[0m"
echo -e "  \033[1;36m00\033[0m) \033[1;32m‹ Volver\033[0m"
echo ""
echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
echo -ne "  \033[1;32mSelecciona una opción:\033[0m "
read -r resp

if [[ "$resp" = "1" || "$resp" = "01" ]]; then
    echo ""
    echo -ne "  \033[1;32mMensaje a mostrar:\033[0m "
    read -r msg1
    if [[ -z "$msg1" ]]; then
        echo -e "\n  \033[1;31mCampo vacío o no válido.\033[0m"
        sleep 2
        exec "$0"
    fi

    echo ""
    echo -e "  \033[1;36m01\033[0m) \033[1;37mFuente pequeña\033[0m"
    echo -e "  \033[1;36m02\033[0m) \033[1;37mFuente mediana\033[0m"
    echo -e "  \033[1;36m03\033[0m) \033[1;37mFuente grande\033[0m"
    echo -e "  \033[1;36m04\033[0m) \033[1;37mFuente gigante\033[0m"
    echo ""
    echo -ne "  \033[1;32mTamaño de fuente:\033[0m "
    read -r opc
    case "$opc" in
        1|01) _size='6' ;;
        2|02) _size='4' ;;
        3|03) _size='3' ;;
        4|04) _size='1' ;;
        *) _size='4' ;;
    esac

    echo ""
    echo -e "  \033[1;36m01\033[0m) Azul       \033[1;36m06\033[0m) Cian"
    echo -e "  \033[1;36m02\033[0m) Verde      \033[1;36m07\033[0m) Naranja"
    echo -e "  \033[1;36m03\033[0m) Rojo       \033[1;36m08\033[0m) Morado"
    echo -e "  \033[1;36m04\033[0m) Amarillo   \033[1;36m09\033[0m) Negro"
    echo -e "  \033[1;36m05\033[0m) Rosa       \033[1;36m10\033[0m) Sin color"
    echo ""
    echo -ne "  \033[1;32mColor:\033[0m "
    read -r ban_cor

    case "$ban_cor" in
        1|01) echo "<h$_size><font color='blue'>$msg1</font></h$_size>" >> "$local" ;;
        2|02) echo "<h$_size><font color='green'>$msg1</font></h$_size>" >> "$local" ;;
        3|03) echo "<h$_size><font color='red'>$msg1</font></h$_size>" >> "$local" ;;
        4|04) echo "<h$_size><font color='yellow'>$msg1</font></h$_size>" >> "$local" ;;
        5|05) echo "<h$_size><font color='#F535AA'>$msg1</font></h$_size>" >> "$local" ;;
        6|06) echo "<h$_size><font color='cyan'>$msg1</font></h$_size>" >> "$local" ;;
        7|07) echo "<h$_size><font color='#FF7F00'>$msg1</font></h$_size>" >> "$local" ;;
        8|08) echo "<h$_size><font color='#9932CD'>$msg1</font></h$_size>" >> "$local" ;;
        9|09) echo "<h$_size><font color='black'>$msg1</font></h$_size>" >> "$local" ;;
        10)   echo "<h$_size>$msg1</h$_size>" >> "$local" ;;
        *)
            echo -e "\n  \033[1;31mOpción no válida.\033[0m"
            sleep 2
            exec "$0"
            ;;
    esac

    service ssh restart >/dev/null 2>&1
    service dropbear restart >/dev/null 2>&1
    echo -e "\n  \033[1;32m✓ Banner definido correctamente.\033[0m"
    sleep 2
    menu 2>/dev/null || exit 0

elif [[ "$resp" = "2" || "$resp" = "02" ]]; then
    echo " " > "$local"
    service ssh restart >/dev/null 2>&1
    service dropbear restart >/dev/null 2>&1
    echo -e "\n  \033[1;32m✓ Banner eliminado.\033[0m"
    sleep 2
    menu 2>/dev/null || exit 0

elif [[ "$resp" = "0" || "$resp" = "00" || "$resp" = "3" ]]; then
    menu 2>/dev/null || exit 0
else
    echo -e "\n  \033[1;31mOpción no válida.\033[0m"
    sleep 2
    exec "$0"
fi
