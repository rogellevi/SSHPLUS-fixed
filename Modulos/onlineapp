#!/bin/bash
# - optimizado

OUT_DIR="/var/www/html/server"
mkdir -p "$OUT_DIR"

fun_online() {
    local ssh_count=0 vpn_count=0 drp_count=0
    local online

    # SSH: cuenta conexiones de usuarios (no root, sesiones privilegiadas)
    ssh_count=$(pgrep -f "sshd:.*priv" 2>/dev/null | wc -l)

    # OpenVPN
    if [[ -r /etc/openvpn/openvpn-status.log ]]; then
        vpn_count=$(grep -c "10.8.0" /etc/openvpn/openvpn-status.log 2>/dev/null)
        [[ -z "$vpn_count" ]] && vpn_count=0
    fi

    # Dropbear
    if [[ -e /etc/default/dropbear ]]; then
        local drp
        drp=$(pgrep -c dropbear 2>/dev/null)
        [[ -z "$drp" ]] && drp=0
        drp_count=$(( drp > 0 ? drp - 1 : 0 ))
    fi

    online=$(( ssh_count + vpn_count + drp_count ))

    printf '{"onlines":"%s","limite":"2500"}\n' "$online" > "$OUT_DIR/online_app"
    printf '%s\n' "$online" > "$OUT_DIR/online"
}

while true; do
    fun_online
    sleep 15
done