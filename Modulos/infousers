#!/bin/bash
clear
echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
echo -e "\033[0;34m║\033[0m\033[1;37m              \033[1;36mREPORTE DE USUARIOS\033[1;37m                 \033[0;34m║\033[0m"
echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
echo ""
echo -e "  \033[1;36mUsuario\033[0m        \033[1;36mContraseña\033[0m    \033[1;36mLímite\033[0m     \033[1;36mExpira\033[0m"
echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"

for users in $(awk -F: '$3 > 900 { print $1 }' /etc/passwd | sort | grep -v "nobody" | grep -vi polkitd | grep -vi system-); do
    if [[ $(grep -cw "$users" /etc/SSHPlus/usuarios.db 2>/dev/null) == "1" ]]; then
        lim=$(grep -w "$users" /etc/SSHPlus/usuarios.db | cut -d' ' -f2)
    else
        lim="1"
    fi

    if [[ -e "/etc/SSHPlus/senha/$users" ]]; then
        senha=$(cat "/etc/SSHPlus/senha/$users")
    else
        senha="Null"
    fi

    datauser=$(chage -l "$users" 2>/dev/null | grep -i co | awk -F: '{print $2}' | xargs)
    if [[ "$datauser" == "never" ]] || [[ -z "$datauser" ]]; then
        data="\033[1;33mNunca\033[0m"
    else
        databr="$(date -d "$datauser" +"%Y%m%d" 2>/dev/null)"
        hoje="$(date -d today +"%Y%m%d")"
        if [[ -n "$databr" ]] && [[ "$hoje" -ge "$databr" ]]; then
            data="\033[1;31mVencido\033[0m"
        else
            dat="$(date -d "$datauser" '+%Y-%m-%d' 2>/dev/null)"
            dias=$(( ($(date -ud "$dat" +%s) - $(date -ud "$(date +%Y-%m-%d)" +%s)) / 86400 ))
            data=$(echo -e "\033[1;32m$dias\033[1;37m días\033[0m")
        fi
    fi

    Usuario=$(printf '%-15s' "$users")
    Senha=$(printf '%-13s' "$senha")
    Limite=$(printf '%-10s' "$lim")
    echo -e "  \033[1;37m$Usuario\033[0m \033[1;33m$Senha\033[0m \033[1;36m$Limite\033[0m $data"
done

echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
echo ""

_tuser=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)
_ons=$(ps -x | grep sshd | grep -v root | grep priv | wc -l)
[[ -f /etc/SSHPlus/Exp ]] && [[ "$(cat /etc/SSHPlus/Exp)" != "" ]] && _expuser=$(cat /etc/SSHPlus/Exp) || _expuser="0"
[[ -e /etc/openvpn/openvpn-status.log ]] && _onop=$(grep -c "10.8.0" /etc/openvpn/openvpn-status.log) || _onop="0"
[[ -e /etc/default/dropbear ]] && _drp=$(ps aux | grep dropbear | grep -v grep | wc -l) && _ondrp=$((_drp - 1)) || _ondrp="0"
_onli=$((_ons + _onop + _ondrp))

echo -e "  \033[1;33m•\033[0m \033[1;36mTotal:\033[1;37m $_tuser   \033[1;33m•\033[0m \033[1;32mEn línea:\033[1;37m $_onli   \033[1;33m•\033[0m \033[1;31mVencidos:\033[1;37m $_expuser"
echo ""
