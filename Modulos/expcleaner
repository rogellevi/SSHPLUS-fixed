#!/bin/bash
datenow=$(date +%s)

remove_ovp() {
    if [[ -e /etc/debian_version ]]; then
        GROUPNAME=nogroup
    fi
    user="$1"
    cd /etc/openvpn/easy-rsa/ 2>/dev/null || return
    ./easyrsa --batch revoke "$user" >/dev/null 2>&1
    ./easyrsa gen-crl >/dev/null 2>&1
    rm -rf "pki/reqs/$user.req" "pki/private/$user.key" "pki/issued/$user.crt" 2>/dev/null
    rm -rf /etc/openvpn/crl.pem 2>/dev/null
    cp /etc/openvpn/easy-rsa/pki/crl.pem /etc/openvpn/crl.pem 2>/dev/null
    chown nobody:$GROUPNAME /etc/openvpn/crl.pem 2>/dev/null
    [[ -e "$HOME/$user.ovpn" ]] && rm -f "$HOME/$user.ovpn"
    [[ -e "/var/www/html/openvpn/$user.zip" ]] && rm -f "/var/www/html/openvpn/$user.zip"
}

clear
echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
echo -e "\033[0;34m║\033[0m\033[1;37m         \033[1;36mELIMINAR USUARIOS EXPIRADOS\033[1;37m              \033[0;34m║\033[0m"
echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
echo ""
echo -e "  \033[1;36mUsuario\033[0m           \033[1;36mFecha\033[0m            \033[1;36mEstado\033[0m"
echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"

for user in $(awk -F: '{print $1}' /etc/passwd); do
    expdate=$(chage -l "$user" 2>/dev/null | awk -F: '/Account expires/{print $2}' | xargs)
    echo "$expdate" | grep -q never && continue
    [[ -z "$expdate" ]] && continue

    datanormal=$(date -d "$expdate" '+%d/%m/%Y' 2>/dev/null) || continue
    expsec=$(date +%s --date="$expdate" 2>/dev/null) || continue
    diff=$((datenow - expsec))

    if [[ $diff -lt 0 ]]; then
        printf "  \033[1;37m%-15s\033[0m  \033[1;33m%-14s\033[0m  \033[1;32mActivo (no eliminado)\033[0m\n" "$user" "$datanormal"
        continue
    fi

    printf "  \033[1;37m%-15s\033[0m  \033[1;31m%-14s\033[0m  \033[1;31mVencido → eliminado\033[0m\n" "$user" "$datanormal"
    pkill -f "$user" 2>/dev/null
    userdel --force "$user" 2>/dev/null
    if [[ -f /etc/SSHPlus/usuarios.db ]]; then
        grep -v "^${user}[[:space:]]" /etc/SSHPlus/usuarios.db > /tmp/ph
        cat /tmp/ph > /etc/SSHPlus/usuarios.db
        rm -f /tmp/ph
    fi
    if [[ -e /etc/openvpn/server.conf ]]; then
        remove_ovp "$user"
    fi
done

echo '0' > /etc/SSHPlus/Exp 2>/dev/null
echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
echo ""
