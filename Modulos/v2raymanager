    uninstall_v2panel () {
    clear
    echo -e "\E[44;1;37m            Desinstalar Panel Web V2Panel             \E[0m"
    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    if [[ ! -f /opt/v2panel/v2panel.py ]] && ! systemctl list-unit-files 2>/dev/null | grep -q v2panel; then
        echo -e "\033[1;33mEl panel no está instalado.\033[0m"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;37m• \033[1;33mPresiona ENTER para continuar\033[1;31m" && read enter
        fun_v2raymanager
        return
    fi
    echo -ne "\033[1;31m¿Desinstalar V2Panel? (s/n): \033[0m"
    read conf
    [[ "$conf" != "s" && "$conf" != "S" ]] && {
        fun_v2raymanager
        return
    }
    systemctl stop v2panel 2>/dev/null || true
    systemctl disable v2panel 2>/dev/null || true
    rm -f /etc/systemd/system/v2panel.service
    systemctl daemon-reload 2>/dev/null || true
    rm -rf /opt/v2panel /etc/v2panel
    echo -e "\n\033[1;32m¡V2Panel eliminado correctamente!\033[0m"
    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "\033[1;37m• \033[1;33mPresiona ENTER para continuar\033[1;31m" && read enter
    fun_v2raymanager
    }

