        echo -e "\033[1;37m• \033[1;33mPresiona ENTER para continuar\033[1;31m" && read enter
        fun_v2raymanager
        return
    fi
    chmod +x "$TMPDIR/install.sh"
    bash "$TMPDIR/install.sh"
    rm -rf "$TMPDIR"
    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
