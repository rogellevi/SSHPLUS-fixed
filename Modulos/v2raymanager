    install_v2panel () {
    clear
    echo -e "\E[44;1;37m            Instalar Panel Web V2Panel             \E[0m"
    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
