        echo -e "\033[1;33mEl panel ya está instalado.\033[0m"
        if [[ -f /etc/v2panel/config.json ]]; then
            PORT=$(python3 -c "import json;print(json.load(open('/etc/v2panel/config.json')).get('port',''))" 2>/dev/null)
            SCHEME=$(python3 -c "import json;print('https' if json.load(open('/etc/v2panel/config.json')).get('https') else 'http')" 2>/dev/null)
            IP=$(hostname -I 2>/dev/null | awk '{print $1}')
            echo -e "\033[1;37m  URL: \033[1;32m${SCHEME}://${IP}:${PORT}\033[0m"
            echo -e "\033[1;37m  Token: \033[1;32m$(python3 /opt/v2panel/v2panel.py token 2>/dev/null)\033[0m"
        fi
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;37m• \033[1;33mPresiona ENTER para continuar\033[1;31m" && read enter
        fun_v2raymanager
        return
    fi
    command -v python3 >/dev/null || { apt-get update -y && apt-get install -y python3; }
    TMPDIR=$(mktemp -d)
    echo -e "\033[1;33mDescargando archivos del panel...\033[0m"
    if ! curl -fsSL "https://raw.githubusercontent.com/rogellevi/SSHPLUS-fixed/main/Modulos/panel/v2panel.py" -o "$TMPDIR/v2panel.py"; then
        echo -e "\033[1;31mError: no se pudo descargar v2panel.py\033[0m"
        rm -rf "$TMPDIR"
        echo -e "\033[1;37m• \033[1;33mPresiona ENTER para continuar\033[1;31m" && read enter
        fun_v2raymanager
        return
    fi
    if ! curl -fsSL "https://raw.githubusercontent.com/rogellevi/SSHPLUS-fixed/main/Modulos/panel/install.sh" -o "$TMPDIR/install.sh"; then
        echo -e "\033[1;31mError: no se pudo descargar install.sh\033[0m"
