#!/bin/bash
clear

fun_bar() {
    comando[0]="$1"
    comando[1]="$2"
    (
        [[ -e $HOME/fim ]] && rm -f $HOME/fim
        ${comando[0]} >/dev/null 2>&1
        ${comando[1]} >/dev/null 2>&1
        touch $HOME/fim
    ) >/dev/null 2>&1 &
    tput civis
    echo -ne "  \033[1;33mEspera \033[1;37m- \033[1;33m["
    while true; do
        for ((i = 0; i < 18; i++)); do
            echo -ne "\033[1;31m#"
            sleep 0.1s
        done
        [[ -e $HOME/fim ]] && rm -f $HOME/fim && break
        echo -e "\033[1;33m]"
        sleep 1s
        tput cuu1
        tput dl1
        echo -ne "  \033[1;33mEspera \033[1;37m- \033[1;33m["
    done
    echo -e "\033[1;33m]\033[1;37m - \033[1;32mOK\033[1;37m"
    tput cnorm
}

fun_atts() {
    [[ -e /home/versao ]] && rm -f /home/versao
    [[ -e /tmp/att ]] && rm -f /tmp/att
    wget -c -P /home https://raw.githubusercontent.com/rogellevi/SSHPLUS-fixed/master/Install/versao 2>/dev/null
    [[ -f "/home/versao" ]] && mv /home/versao /tmp/att
} >/dev/null 2>&1

echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
echo -e "\033[0;34m║\033[0m\033[1;37m           \033[1;36mACTUALIZAR SCRIPT\033[1;37m                      \033[0;34m║\033[0m"
echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
echo ""
echo -e "  \033[1;32mVerificando actualizaciones disponibles...\033[0m\n"
fun_bar 'fun_atts'

if [[ ! -f "/tmp/att" ]]; then
    echo -e "\n  \033[1;31mError al conectar con el servidor.\033[0m\n"
    echo -ne "  \033[1;36mPresiona ENTER para volver al menú:\033[0m "
    read -r
    menu 2>/dev/null || exit 0
fi

echo ""
vrs1=$(sed -n '1 p' /bin/versao 2>/dev/null | sed -e 's/[^0-9]//ig')
vrs2=$(sed -n '1 p' /tmp/att 2>/dev/null | sed -e 's/[^0-9]//ig')

if [[ "$vrs1" == "$vrs2" ]]; then
    echo -e "  \033[1;32m✓ El script ya está actualizado.\033[0m\n"
    rm -f /tmp/att >/dev/null 2>&1
    echo -ne "  \033[1;36mPresiona ENTER para volver al menú:\033[0m "
    read -r
    menu 2>/dev/null || exit 0
else
    echo -e "  \033[1;33m¡Existe una nueva actualización disponible!\033[0m\n"
    echo -e "  \033[1;32mDetalles de la actualización:\033[0m\n"
    while read -r linha; do
        echo -e "  \033[1;37m• \033[1;33m$linha\033[0m"
    done < "/tmp/att"
    echo ""
    echo -ne "  \033[1;32m¿Deseas actualizar?\033[0m [s/n]: "
    read -r res
    if [[ "$res" = s || "$res" = S ]]; then
        echo -e "\n  \033[1;32mIniciando actualización...\033[0m\n"
        sleep 2
        wget -q https://raw.githubusercontent.com/rogellevi/SSHPLUS-fixed/master/Plus -O Plus
        chmod +x Plus
        ./Plus
        clear
        echo -e "\n  \033[1;32m✓ Script actualizado correctamente.\033[0m\n"
        rm -f /tmp/att >/dev/null 2>&1
        echo -ne "  \033[1;36mPresiona ENTER para volver al menú:\033[0m "
        read -r
        menu 2>/dev/null || exit 0
    else
        menu 2>/dev/null || exit 0
    fi
fi
