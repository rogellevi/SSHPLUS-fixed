#!/bin/bash
#====================================================
#	CheckUser Manager
#====================================================

verif_ptrs() {
    porta=$1
    PT=$(lsof -V -i tcp -P -n 2>/dev/null | grep -v "ESTABLISHED" | grep -v "COMMAND" | grep "LISTEN")
    for pton in $(echo -e "$PT" | cut -d: -f2 | cut -d' ' -f1 | uniq); do
        svcs=$(echo -e "$PT" | grep -w "$pton" | awk '{print $1}' | uniq)
        [[ "$porta" = "$pton" ]] && {
            echo -e "\n  \033[1;31mPuerto \033[1;33m$porta \033[1;31men uso por \033[1;37m$svcs\033[0m"
            sleep 3
            fun_initcheck
        }
    done
}

fun_bar() {
    comando[0]="$1"
    comando[1]="$2"
    (
        [[ -e $HOME/fim ]] && rm -f $HOME/fim
        ${comando[0]} >/dev/null 2>&1
        ${comando[1]} >/dev/null 2>&1
        touch $HOME/fim
    ) >/dev/null 2>&1 &
    tput civis
    echo -ne "  \033[1;33mEspera \033[1;37m- \033[1;33m["
    while true; do
        for ((i = 0; i < 18; i++)); do
            echo -ne "\033[1;31m#"
            sleep 0.1s
        done
        [[ -e $HOME/fim ]] && rm -f $HOME/fim && break
        echo -e "\033[1;33m]"
        sleep 1s
        tput cuu1
        tput dl1
        echo -ne "  \033[1;33mEspera \033[1;37m- \033[1;33m["
    done
    echo -e "\033[1;33m]\033[1;37m - \033[1;32mOK\033[1;37m"
    tput cnorm
}

fun_formato_fecha() {
    while true; do
        clear
        echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
        echo -e "  \033[1;36mFORMATO DE FECHA PARA CHECKUSER\033[0m"
        echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
        echo ""
        echo -e "  \033[1;33mEl formato de la fecha puede variar dependiendo\033[0m"
        echo -e "  \033[1;33mde la programación de tu aplicación.\033[0m"
        echo -e "  \033[1;33mSelecciona el formato según tu necesidad.\033[0m"
        echo ""
        echo -e "  \033[1;36m[1]\033[0m \033[1;37mYYYY/MM/DD\033[0m  \033[1;33m(más común · 2025/12/31)\033[0m"
        echo -e "  \033[1;36m[2]\033[0m \033[1;37mDD/MM/YYYY\033[0m  \033[1;33m(31/12/2025)\033[0m"
        echo ""
        echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
        echo -ne "  \033[1;32mOpción:\033[0m "
        read -r fmt
        case "$fmt" in
            1|01) FORMATO="1" ; break ;;
            2|02) FORMATO="2" ; break ;;
            *) echo -e "\n  \033[1;31mOpción no válida.\033[0m" ; sleep 1 ;;
        esac
    done
    export FORMATO
}

fun_initcheck() {
    while true; do
        clear
        var_sks1=$(ps x | grep "checkuser" | grep -v grep >/dev/null && echo -e "\033[1;32m● " || echo -e "\033[1;31m○ ")
        var_sks2=$(ps x | grep "4gcheck" | grep -v grep >/dev/null && echo -e "\033[1;32m● " || echo -e "\033[1;31m○ ")

        echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
        echo -e "\033[0;34m║\033[0m\033[1;37m               \033[1;36mADMINISTRAR CHECKUSER\033[1;37m              \033[0;34m║\033[0m"
        echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
        echo ""
        echo -e "  \033[1;36m01\033[0m) \033[1;37mCheckUser (estándar)\033[0m $var_sks1"
        echo -e "  \033[1;36m02\033[0m) \033[1;37mCheckUser (Conecta4G)\033[0m $var_sks2"
        echo -e "  \033[1;36m00\033[0m) \033[1;32m‹ Volver\033[0m"
        echo ""
        echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
        echo -ne "  \033[1;32mSelecciona una opción:\033[0m "
        read -r resposta

        case "$resposta" in
        1|01)
            if ps x | grep -w checkuser | grep -v grep >/dev/null 2>&1; then
                clear
                echo -e "\033[0;34m──\033[0m \033[1;36mCHECKUSER (ESTÁNDAR)\033[0m \033[0;34m──\033[0m"
                echo ""
                echo -e "  \033[1;32mDeteniendo CheckUser...\033[0m\n"
                fun_stopbad() {
                    screen -r -S "checkuser" -X quit 2>/dev/null
                    screen -wipe >/dev/null 2>&1
                }
                fun_bar 'fun_stopbad'
                echo -e "\n  \033[1;32m✓ CheckUser detenido.\033[0m\n"
                sleep 2
            else
                clear
                echo -e "\033[0;34m──\033[0m \033[1;36mCHECKUSER (ESTÁNDAR)\033[0m \033[0;34m──\033[0m"
                echo ""
                echo -ne "  \033[1;32m¿Qué puerto deseas utilizar?:\033[0m "
                read -r porta
                [[ -z "$porta" ]] && {
                    echo -e "\n  \033[1;31mPuerto no válido.\033[0m"
                    sleep 2
                    continue
                }
                verif_ptrs "$porta"

                fun_formato_fecha

                echo -e "\n  \033[1;32mIniciando CheckUser...\033[0m\n"
                fun_inisks() {
                    screen -dmS checkuser python3 /etc/SSHPlus/check.py "$porta" "$FORMATO"
                    [[ $(grep -wc "checkuser" /etc/autostart 2>/dev/null) = '0' ]] && {
                        echo -e "ps x | grep 'checkuser' | grep -v 'grep' || screen -dmS checkuser python3 /etc/SSHPlus/check.py $porta $FORMATO" >> /etc/autostart
                    }
                }
                fun_bar 'fun_inisks'
                IP=$(curl -s icanhazip.com 2>/dev/null || cat /etc/IP 2>/dev/null)
                echo -e "\n  \033[1;32m✓ CheckUser activo.\033[0m"
                echo -e "  \033[1;33mURL:\033[0m http://$IP:$porta/checkUser"
                echo -e "  \033[1;33mFormato:\033[0m $([ "$FORMATO" = "1" ] && echo 'YYYY/MM/DD' || echo 'DD/MM/YYYY')\n"
                echo -ne "  \033[1;36mPresiona ENTER para continuar:\033[0m "
                read -r _
            fi
            ;;
        2|02)
            if ps x | grep -w 4gcheck | grep -v grep >/dev/null 2>&1; then
                clear
                echo -e "\033[0;34m──\033[0m \033[1;36mCHECKUSER (CONECTA4G)\033[0m \033[0;34m──\033[0m"
                echo ""
                echo -e "  \033[1;32mDeteniendo CheckUser 4G...\033[0m\n"
                fun_stop4g() {
                    screen -r -S "4gcheck" -X quit 2>/dev/null
                    screen -wipe >/dev/null 2>&1
                }
                fun_bar 'fun_stop4g'
                echo -e "\n  \033[1;32m✓ CheckUser 4G detenido.\033[0m\n"
                sleep 2
            else
                clear
                echo -e "\033[0;34m──\033[0m \033[1;36mCHECKUSER (CONECTA4G)\033[0m \033[0;34m──\033[0m"
                echo ""
                echo -ne "  \033[1;32m¿Qué puerto deseas utilizar?:\033[0m "
                read -r porta
                [[ -z "$porta" ]] && {
                    echo -e "\n  \033[1;31mPuerto no válido.\033[0m"
                    sleep 2
                    continue
                }
                verif_ptrs "$porta"
                echo -e "\n  \033[1;32mIniciando CheckUser 4G...\033[0m\n"
                fun_ini4g() {
                    screen -dmS 4gcheck python3 /etc/SSHPlus/4gcheck.py "$porta"
                    [[ $(grep -wc "4gcheck" /etc/autostart 2>/dev/null) = '0' ]] && {
                        echo -e "ps x | grep '4gcheck' | grep -v 'grep' || screen -dmS 4gcheck python3 /etc/SSHPlus/4gcheck.py $porta" >> /etc/autostart
                    }
                }
                fun_bar 'fun_ini4g'
                IP=$(curl -s icanhazip.com 2>/dev/null || cat /etc/IP 2>/dev/null)
                echo -e "\n  \033[1;32m✓ CheckUser 4G activo.\033[0m"
                echo -e "  \033[1;33mURL:\033[0m http://$IP:$porta/checkUser\n"
                echo -ne "  \033[1;36mPresiona ENTER para continuar:\033[0m "
                read -r _
            fi
            ;;
        0|00)
            echo -e "\n  \033[1;31mVolviendo...\033[0m"
            sleep 1
            menu 2>/dev/null || exit 0
            ;;
        *)
            echo -e "\n  \033[1;31mOpción no válida.\033[0m"
            sleep 1
            ;;
        esac
    done
}

inst_depedencias() {
    if ! [ -x "$(command -v pip3)" ]; then
        echo -e "  \033[1;33mpip3 no está instalado. Instalando...\033[0m"
        apt-get install -y python3-pip >/dev/null 2>&1
    fi
    pip3 install flask >/dev/null 2>&1

    [[ ! -e "/etc/SSHPlus/check.py" ]] && {
        cd "$HOME" || return
        wget -q https://www.dropbox.com/s/2s1u9kmfgkj6l4r/check.py -O /etc/SSHPlus/check.py 2>/dev/null
    }
    [[ ! -e "/etc/SSHPlus/4gcheck.py" ]] && {
        cd "$HOME" || return
        wget -q https://www.dropbox.com/s/oe3m2gc0sh52hq1/4gcheck.py -O /etc/SSHPlus/4gcheck.py 2>/dev/null
    }
    [[ ! -e "/bin/check" ]] && {
        cd "$HOME" || return
        wget -q https://www.dropbox.com/s/f68x0kiijx0w9r7/check -O /bin/check 2>/dev/null
        chmod 777 /bin/check 2>/dev/null
    }
}

# Entrada principal
if [[ -e "/etc/SSHPlus/check.py" ]] && [[ -e "/etc/SSHPlus/4gcheck.py" ]] && [[ -e "/bin/check" ]]; then
    fun_initcheck
else
    clear
    echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
    echo -e "\033[0;34m║\033[0m\033[1;37m           \033[1;36mINSTALADOR CHECKUSER\033[1;37m                   \033[0;34m║\033[0m"
    echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
    echo ""
    echo -e "  \033[1;33mEstás a punto de instalar CheckUser.\033[0m"
    echo ""
    echo -ne "  \033[1;32m¿Deseas continuar?\033[0m [s/n]: "
    read -r resposta
    if [[ "$resposta" = 's' || "$resposta" = 'S' ]]; then
        clear
        echo -e "\n  \033[1;32mInstalando CheckUser...\033[0m\n"
        fun_bar 'inst_depedencias'
        echo -e "\n  \033[1;32m✓ CheckUser instalado.\033[0m\n"
        sleep 2
        fun_initcheck
    else
        echo -e "\n  \033[1;31mVolviendo...\033[0m"
        sleep 1
        menu 2>/dev/null || exit 0
    fi
fi