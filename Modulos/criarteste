#!/bin/bash
IP=$(cat /etc/IP 2>/dev/null)

if [[ ! -d /etc/SSHPlus/userteste ]]; then
    mkdir -p /etc/SSHPlus/userteste
fi

clear
echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
echo -e "\033[0;34m║\033[0m\033[1;37m         \033[1;36mCREAR USUARIO DE PRUEBA\033[1;37m                  \033[0;34m║\033[0m"
echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
echo ""

if [[ "$(ls -A /etc/SSHPlus/userteste 2>/dev/null)" ]]; then
    echo -e "  \033[1;32mPruebas activas:\033[0m"
    for testeson in $(ls /etc/SSHPlus/userteste | sort | sed 's/.sh//g'); do
        echo -e "  \033[1;37m• $testeson\033[0m"
    done
else
    echo -e "  \033[1;31mNinguna prueba activa.\033[0m"
fi

echo ""
echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
echo ""

echo -ne "  \033[1;32mNombre de usuario:\033[0m "
read -r nome
if [[ -z "$nome" ]]; then
    echo ""
    echo -e "  \033[1;31mNombre vacío o no válido.\033[0m"
    echo ""
    exit 1
fi

awk -F: '{ print $1 }' /etc/passwd > /tmp/users
if grep -Fxq "$nome" /tmp/users; then
    echo ""
    echo -e "  \033[1;31mEste usuario ya existe.\033[0m"
    echo ""
    exit 1
fi

echo -ne "  \033[1;32mContraseña:\033[0m "
read -r pass
if [[ -z "$pass" ]]; then
    echo ""
    echo -e "  \033[1;31mContraseña vacía o no válida.\033[0m"
    echo ""
    exit 1
fi

echo -ne "  \033[1;32mLímite de conexiones:\033[0m "
read -r limit
if [[ -z "$limit" ]] || ! [[ "$limit" =~ ^[0-9]+$ ]]; then
    echo ""
    echo -e "  \033[1;31mLímite vacío o no válido.\033[0m"
    echo ""
    exit 1
fi

echo -ne "  \033[1;32mMinutos\033[0m \033[1;33m(ej: 60):\033[0m "
read -r u_temp
if [[ -z "$u_temp" ]] || ! [[ "$u_temp" =~ ^[0-9]+$ ]]; then
    echo ""
    echo -e "  \033[1;31mTiempo vacío o no válido.\033[0m"
    echo ""
    exit 1
fi

useradd -M -s /bin/false "$nome"
(echo "$pass"; echo "$pass") | passwd "$nome" >/dev/null 2>&1
echo "$pass" > "/etc/SSHPlus/senha/$nome"
echo "$nome $limit" >> /etc/SSHPlus/usuarios.db

cat > "/etc/SSHPlus/userteste/$nome.sh" << SCRIPT
#!/bin/bash
pkill -f "$nome"
userdel --force "$nome"
grep -v "^${nome}[[:space:]]" /etc/SSHPlus/usuarios.db > /tmp/ph
cat /tmp/ph > /etc/SSHPlus/usuarios.db
rm -f /etc/SSHPlus/senha/$nome
rm -rf /etc/SSHPlus/userteste/$nome.sh
exit
SCRIPT
chmod +x "/etc/SSHPlus/userteste/$nome.sh"
at -f "/etc/SSHPlus/userteste/$nome.sh" now + "$u_temp" min >/dev/null 2>&1

clear
echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
echo -e "\033[0;34m║\033[0m\033[1;37m       \033[1;32m✓ USUARIO DE PRUEBA CREADO\033[1;37m                 \033[0;34m║\033[0m"
echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
echo ""
echo -e "  \033[1;32mIP:\033[0m         \033[1;37m$IP\033[0m"
echo -e "  \033[1;32mUsuario:\033[0m    \033[1;37m$nome\033[0m"
echo -e "  \033[1;32mContraseña:\033[0m \033[1;37m$pass\033[0m"
echo -e "  \033[1;32mLímite:\033[0m     \033[1;37m$limit\033[0m"
echo -e "  \033[1;32mValidez:\033[0m    \033[1;37m$u_temp minutos\033[0m"
echo ""
echo -e "  \033[1;33mTras el tiempo definido, el usuario\033[0m"
echo -e "  \033[1;37m$nome\033[0m \033[1;33mserá desconectado y eliminado.\033[0m"
echo ""
