            echo -ne "  \033[1;32mHost actual:\033[0m \033[1;37m$Host\033[0m  \033[1;32m¿Modificar?\033[0m \033[1;33m[s/n]:\033[0m "
            read oprc
            [[ "$oprc" = @(s|S) ]] && {
                fun_edithost
            } || {
                fun_geraovpn
            }
            gerarovpn() {
                [[ ! -e "/root/$username.zip" ]] && {
                    zip /root/$username.zip /root/$username.ovpn
                    sleep 1.5
                }
            }
            clear
            echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
            echo -e "\033[0;34m║\033[0m\033[1;37m         \033[1;32m✓ CUENTA SSH CREADA\033[1;37m                      \033[0;34m║\033[0m"
            echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
            echo ""
            echo -e "  \033[1;32mIP:\033[0m                  \033[1;37m$IP\033[0m"
            echo -e "  \033[1;32mUsuario:\033[0m             \033[1;37m$username\033[0m"
            echo -e "  \033[1;32mContraseña:\033[0m          \033[1;37m$password\033[0m"
            echo -e "  \033[1;32mExpira el:\033[0m           \033[1;37m$gui\033[0m"
            echo -e "  \033[1;32mLímite de conexiones:\033[0m \033[1;37m$sshlimiter\033[0m"
            sleep 1
            function ESPERE() {
                helice() {
                    gerarovpn >/dev/null 2>&1 &
                    tput civis
                    while [ -d /proc/$! ]; do
                        for i in / - \\ \|; do
                            sleep .1
                            echo -ne "\e[1D$i"
                        done
                    done
                    tput cnorm
                }
                echo ""
                echo -ne "  \033[1;31mCreando OVPN\033[1;33m... \033[1;32m"
                helice
                echo -e "\e[1DOK"
            }
            ESPERE
            VERSION_ID=$(grep "VERSION_ID" /etc/os-release)
            echo ""
            [[ -d /var/www/html/openvpn ]] && {
                mv $HOME/$username.zip /var/www/html/openvpn/$username.zip >/dev/null 2>&1
                [[ "$VERSION_ID" = 'VERSION_ID="14.04"' ]] && {
                    echo -e "  \033[1;32mLink:\033[0m \033[1;36m$IP:81/html/openvpn/$username.zip\033[0m"
                } || {
                    echo -e "  \033[1;32mLink:\033[0m \033[1;36m$IP:81/openvpn/$username.zip\033[0m"
                }
            } || {
                echo -e "  \033[1;32mDisponible en:\033[0m ~/$username.zip"
                sleep 1
            }
            echo ""
        } || {
            clear
            echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
            echo -e "\033[0;34m║\033[0m\033[1;37m         \033[1;32m✓ CUENTA SSH CREADA\033[1;37m                      \033[0;34m║\033[0m"
            echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
            echo ""
            echo -e "  \033[1;32mIP:\033[0m                  \033[1;37m$IP\033[0m"
            echo -e "  \033[1;32mUsuario:\033[0m             \033[1;37m$username\033[0m"
            echo -e "  \033[1;32mContraseña:\033[0m          \033[1;37m$password\033[0m"
            echo -e "  \033[1;32mExpira el:\033[0m           \033[1;37m$gui\033[0m"
            echo -e "  \033[1;32mLímite de conexiones:\033[0m \033[1;37m$sshlimiter\033[0m"
            echo ""
        }
    } || {
        clear
        echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
        echo -e "\033[0;34m║\033[0m\033[1;37m         \033[1;32m✓ CUENTA SSH CREADA\033[1;37m                      \033[0;34m║\033[0m"
        echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
        echo ""
        echo -e "  \033[1;32mIP:\033[0m                  \033[1;37m$IP\033[0m"
        echo -e "  \033[1;32mUsuario:\033[0m             \033[1;37m$username\033[0m"
        echo -e "  \033[1;32mContraseña:\033[0m          \033[1;37m$password\033[0m"
        echo -e "  \033[1;32mExpira el:\033[0m           \033[1;37m$gui\033[0m"
        echo -e "  \033[1;32mLímite de conexiones:\033[0m \033[1;37m$sshlimiter\033[0m"
        echo ""
    }
fi
