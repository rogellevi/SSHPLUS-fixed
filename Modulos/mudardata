#!/bin/bash
clear
echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
echo -e "\033[0;34m║\033[0m\033[1;37m            \033[1;36mCAMBIAR FECHA DE EXPIRACIÓN\033[1;37m           \033[0;34m║\033[0m"
echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
echo ""

echo -e "  \033[1;33mLista de usuarios y fecha de caducidad:\033[0m"
echo ""
echo -e "  \033[1;36mNº\033[0m   \033[1;36mUsuario\033[0m              \033[1;36mFecha\033[0m      \033[1;36mEstado\033[0m"
echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"

list_user=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody)
i=0
unset _userPass

while read -r user; do
    i=$((i + 1))
    _oP=$i
    num=$(printf "%02d" $i)

    expire=$(chage -l "$user" 2>/dev/null | grep -iE "Account expires|Cuenta caduca" | cut -d: -f2 | xargs)

    if [[ "$expire" == "never" ]] || [[ -z "$expire" ]]; then
        printf "  \033[1;36m%s\033[0m)\033[1;37m%-18s\033[0m  \033[1;33m00/00/0000\033[0m   \033[1;33mSin fecha\033[0m\n" "$num" "$user"
    else
        databr=$(date -d "$expire" +"%Y%m%d" 2>/dev/null)
        hoje=$(date -d today +"%Y%m%d")
        datanormal=$(date -d "$expire" '+%d/%m/%Y' 2>/dev/null)

        if [[ -n "$databr" ]] && [[ "$hoje" -ge "$databr" ]]; then
            printf "  \033[1;36m%s\033[0m)  \033[1;37m%-18s\033[0m  \033[1;31m%s\033[0m   \033[1;31mVencido\033[0m\n" "$num" "$user" "$datanormal"
        else
            printf "  \033[1;36m%s\033[0m)  \033[1;37m%-18s\033[0m  \033[1;33m%s\033[0m   \033[1;32mActivo\033[0m\n" "$num" "$user" "$datanormal"
        fi
    fi
    _userPass+="\n${_oP}:${user}"
done <<< "${list_user}"

echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
echo ""

num_user=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)
echo -ne "  \033[1;32mSelecciona un usuario\033[0m \033[1;33m[1-$num_user]\033[0m: "
read -r option

if [[ -z "$option" ]]; then
    echo ""
    echo -e "  \033[1;31mError: nombre de usuario vacío o inválido.\033[0m"
    exit 1
fi

usuario=$(echo -e "${_userPass}" | grep -E "\b$option\b" | cut -d: -f2)

if [[ -z "$usuario" ]]; then
    echo ""
    echo -e "  \033[1;31mError: nombre de usuario vacío o inválido.\033[0m"
    echo ""
    exit 1
fi

if ! grep -q "/${usuario}:" /etc/passwd; then
    echo ""
    echo -e "  \033[1;31mEl usuario $usuario no existe.\033[0m"
    echo ""
    exit 1
fi

echo ""
echo -e "  \033[1;33mEjemplos:\033[0m  \033[1;37m21/04/2026\033[0m  (fecha)   o   \033[1;37m30\033[0m  (días)"
echo ""
echo -ne "  \033[1;32mNueva fecha o días para\033[0m \033[1;33m$usuario\033[0m: "
read -r inputdate

if [[ -z "$inputdate" ]]; then
    echo ""
    echo -e "  \033[1;31mIngresaste una fecha no válida.\033[0m"
    echo -e "  Usa formato DÍA/MES/AÑO  (ej: 21/04/2026)  o días (ej: 30)"
    echo ""
    exit 1
fi

if [[ "$(echo "$inputdate" | grep -c "/")" = "0" ]]; then
    # Es número de días
    if ! [[ "$inputdate" =~ ^[0-9]+$ ]]; then
        echo ""
        echo -e "  \033[1;31mIngresaste un valor no válido.\033[0m"
        echo ""
        exit 1
    fi
    udata=$(date "+%d/%m/%Y" -d "+$inputdate days")
    sysdate=$(echo "$udata" | awk -v FS=/ -v OFS=- '{print $3,$2,$1}')
else
    udata="$inputdate"
    sysdate=$(echo "$inputdate" | awk -v FS=/ -v OFS=- '{print $3,$2,$1}')
fi

if ! date "+%Y-%m-%d" -d "$sysdate" >/dev/null 2>&1; then
    echo ""
    echo -e "  \033[1;31mFecha no válida. Usa formato DÍA/MES/AÑO (ej: 21/04/2026)\033[0m"
    echo ""
    exit 1
fi

today=$(date -d today +"%Y%m%d")
timemachine=$(date -d "$sysdate" +"%Y%m%d")

if [[ "$today" -ge "$timemachine" ]]; then
    echo ""
    echo -e "  \033[1;31mIngresaste una fecha pasada o el día de hoy.\033[0m"
    echo -e "  Introduce una fecha futura válida."
    echo ""
    exit 1
fi

chage -E "$sysdate" "$usuario"
echo ""
echo -e "  \033[1;32m✓ Usuario\033[0m \033[1;33m$usuario\033[0m \033[1;32m— nueva fecha:\033[0m \033[1;37m$udata\033[0m"
echo ""
