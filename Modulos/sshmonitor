#!/bin/bash
clear

database="/etc/SSHPlus/usuarios.db"

fun_drop() {
    port_dropbear=$(ps aux | grep dropbear | awk 'NR==1 {print $17}')
    log=/var/log/auth.log
    loginsukses='Password auth succeeded'
    pids=$(ps ax | grep dropbear | grep " $port_dropbear" | awk '{print $1}')
    for pid in $pids; do
        pidlogs=$(grep "$pid" "$log" 2>/dev/null | grep "$loginsukses" | awk '{print $3}')
        i=0
        for pidend in $pidlogs; do
            let i=i+1
        done
        if [[ -n "$pidend" ]]; then
            login=$(grep "$pid" "$log" 2>/dev/null | grep "$pidend" | grep "$loginsukses")
            PID=$pid
            user=$(echo "$login" | awk '{print $10}' | sed -r "s/'/ /g")
            waktu=$(echo "$login" | awk '{print $2"-"$1,$3}')
            while [ ${#waktu} -lt 13 ]; do
                waktu="${waktu} "
            done
            while [ ${#user} -lt 16 ]; do
                user="${user} "
            done
            while [ ${#PID} -lt 8 ]; do
                PID="${PID} "
            done
            echo "$user $PID $waktu"
        fi
    done
}

echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
echo -e "\033[0;34m║\033[0m\033[1;37m                \033[1;36mMONITOR EN LÍNEA\033[1;37m                  \033[0;34m║\033[0m"
echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
echo ""
echo -e "  \033[1;36mUsuario\033[0m         \033[1;36mEstado\033[0m    \033[1;36mConexión\033[0m    \033[1;36mTiempo\033[0m"
echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"

if [[ ! -f "$database" ]]; then
    echo -e "\n  \033[1;31mNo se encontró la base de usuarios.\033[0m\n"
    exit 1
fi

while read -r usline; do
    [[ -z "$usline" ]] && continue
    user=$(echo "$usline" | cut -d' ' -f1)
    s2ssh=$(echo "$usline" | cut -d' ' -f2)

    if [[ $(grep -cw "$user" /etc/passwd) = "1" ]]; then
        sqd=$(ps -u "$user" 2>/dev/null | grep -c sshd)
    else
        sqd=0
    fi
    [[ -z "$sqd" ]] && sqd=0

    if [[ -e /etc/openvpn/openvpn-status.log ]]; then
        ovp=$(grep -cE ",$user," /etc/openvpn/openvpn-status.log 2>/dev/null)
    else
        ovp=0
    fi

    if netstat -nltp 2>/dev/null | grep -q 'dropbear'; then
        drop=$(fun_drop | grep -c "$user")
    else
        drop=0
    fi

    cnx=$((sqd + drop))
    conex=$((cnx + ovp))

    if [[ $cnx -gt 0 ]]; then
        tst=$(ps -o etime= -p "$(ps -u "$user" 2>/dev/null | grep sshd | awk 'NR==1 {print $1}')" 2>/dev/null | xargs)
        tst1=$(echo -n "$tst" | wc -c)
        if [[ "$tst1" == "8" ]] || [[ "$tst1" == "9" ]]; then
            timerr="$tst"
        else
            timerr="00:$tst"
        fi
        [[ -z "$timerr" || "$timerr" == "00:" ]] && timerr="00:00:00"
    elif [[ $ovp -gt 0 ]]; then
        tmp2=$(printf '%(%H:%M:%S)T')
        tmp1=$(grep -w "$user" /etc/openvpn/openvpn-status.log 2>/dev/null | awk '{print $4}' | head -1)
        [[ -z "$tmp1" ]] && tmp1="00:00:00" && tmp2="00:00:00"
        var1=$(echo "$tmp1" | cut -c 1-2)
        var2=$(echo "$tmp1" | cut -c 4-5)
        var3=$(echo "$tmp1" | cut -c 7-8)
        var4=$(echo "$tmp2" | cut -c 1-2)
        var5=$(echo "$tmp2" | cut -c 4-5)
        var6=$(echo "$tmp2" | cut -c 7-8)
        calc1=$((10#$var1 * 3600 + 10#$var2 * 60 + 10#$var3))
        calc2=$((10#$var4 * 3600 + 10#$var5 * 60 + 10#$var6))
        seg=$((calc2 - calc1))
        [[ $seg -lt 0 ]] && seg=0
        min=$((seg / 60))
        seg=$((seg - min * 60))
        hor=$((min / 60))
        min=$((min - hor * 60))
        timerr=$(printf "%02d:%02d:%02d" $hor $min $seg)
    else
        timerr="00:00:00"
    fi

    if [[ $conex -eq 0 ]]; then
        status=$(echo -e "\033[1;31mOffline\033[0m")
    else
        status=$(echo -e "\033[1;32mOnline\033[0m  ")
    fi

    printf "  \033[1;37m%-15s\033[0m %-22s \033[1;36m%-8s\033[0m \033[1;33m%s\033[0m\n" \
        "$user" "$status" "$conex/$s2ssh" "$timerr"
done < "$database"

echo -e "\033[0;34m──────────────────────────────────────────────────\033[0m"
echo ""
