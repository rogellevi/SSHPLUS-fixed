	fun_openssh() {
		clear
		cabecera "OPENSSH"; echo ""
		echo -e "  \033[1;36m1\033[0m) \033[1;37mAgregar puerto
  \033[1;36m2\033[0m) \033[1;37mEliminar puerto
  \033[1;36m3\033[0m) \033[1;37mVolver\033[0m"
		echo ""
		echo -ne "  \033[1;32mSelecciona una opción:\033[0m "
		read resp
		if [[ "$resp" = '1' ]]; then
			clear
			cabecera "AGREGAR PUERTO SSH"; echo ""
			echo -ne "\033[1;32m¿Qué puerto deseas agregar?\033[1;37m "
			read pt
			[[ -z "$pt" ]] && {
				echo -e "\n\033[1;31m¡Puerto no válido!"
				sleep 3
				fun_conexao
			}
			verif_ptrs $pt
			echo -e "\n\033[1;32mAgregando puerto a SSH...\033[0m"
			echo ""
			fun_addpssh() {
				echo "Port $pt" >>/etc/ssh/sshd_config
				service ssh restart
			}
			fun_bar 'fun_addpssh'
			echo -e "\n\033[1;32m¡Puerto agregado correctamente\033[0m"
			sleep 3
			fun_conexao
		elif [[ "$resp" = '2' ]]; then
			clear
			cabecera "ELIMINAR PUERTO SSH"
			echo -e "\n\033[1;33m[\033[1;31m!\033[1;33m] \033[1;32mPUERTO por defecto \033[1;37m22 \033[1;33m¡Cuidado!\033[0m"
			echo -e "\n\033[1;33mPuertos en uso: \033[1;36m$(grep 'Port' /etc/ssh/sshd_config | cut -d' ' -f2 | grep -v 'no' | xargs)\n"
			echo -ne "\033[1;32m¿Qué puerto deseas eliminar?\033[1;37m "
			read pt
			[[ -z "$pt" ]] && {
				echo -e "\n\033[1;31m¡Puerto no válido!"
				sleep 2
				fun_conexao
			}
			[[ $(grep -wc "$pt" '/etc/ssh/sshd_config') != '0' ]] && {
				echo -e "\n\033[1;32mEliminando puerto SSH\033[0m"
				echo ""
				fun_delpssh() {
					sed -i "/Port $pt/d" /etc/ssh/sshd_config
					service ssh restart
				}
				fun_bar 'fun_delpssh'
				echo -e "\n\033[1;32mPuerto eliminado correctamente\033[0m"
				sleep 2
				fun_conexao
			} || {
				echo -e "\n\033[1;31m¡Puerto no válido!"
				sleep 2
				fun_conexao
			}
		elif [[ "$resp" = '3' ]]; then
			echo -e "\n\033[1;31mVolviendo..."
			sleep 2
			fun_conexao
		else
			echo -e "\n\033[1;31m¡Opción no válida!"
			sleep 2
			fun_conexao
		fi
	}

