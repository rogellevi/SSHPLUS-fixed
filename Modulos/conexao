#!/bin/bash
#====================================================
#	SSHPlus - Modo de Conexión
#====================================================
cor1='\033[1;31m'
cor2='\033[1;36m'
scor='\033[0m'
GREEN='\033[1;32m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
SCOLOR='\033[0m'
ram1=$(free -h | grep -i mem | awk {'print $2'})
ram2=$(free -h | grep -i mem | awk {'print $4'})
ram3=$(free -h | grep -i mem | awk {'print $3'})
uso=$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')
system=$(cat /etc/issue.net)
cabecera() {
	local titulo="$1" ancho=50
	local largo=${#titulo}
	local izq=$(( (ancho - largo) / 2 ))
	local der=$(( ancho - largo - izq ))
	echo -e "\033[0;34m╔$(printf '═%.0s' $(seq 1 $ancho))╗\033[0m"
	echo -e "\033[0;34m║\033[0m$(printf '%*s' $izq '')\033[1;36m${titulo}\033[0m$(printf '%*s' $der '')\033[0;34m║\033[0m"
	echo -e "\033[0;34m╚$(printf '═%.0s' $(seq 1 $ancho))╝\033[0m"
}
fun_bar() {
		comando[0]="$1"
		comando[1]="$2"
		(
			[[ -e $HOME/fim ]] && rm $HOME/fim
						${comando[0]} >/dev/null 2>&1
			${comando[1]} >/dev/null 2>&1
			touch $HOME/fim
		) >/dev/null 2>&1 &
		tput civis
		echo -ne "\033[1;33mESPERA \033[1;37m- \033[1;33m["
		while true; do
			for ((i = 0; i < 18; i++)); do
				echo -ne "\033[1;36m#"
				sleep 0.1s
			done
			[[ -e $HOME/fim ]] && rm $HOME/fim && break
			echo -e "\033[1;33m]"
			sleep 1s
			tput cuu1
			tput dl1
			echo -ne "\033[1;33mESPERA \033[1;37m- \033[1;33m["
		done
		echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
		tput cnorm
	}

	verif_ptrs() {
		porta=$1
		PT=$(lsof -V -i tcp -P -n | grep -v "ESTABLISHED" | grep -v "COMMAND" | grep "LISTEN")
		for pton in $(echo -e "$PT" | cut -d: -f2 | cut -d' ' -f1 | uniq); do
			svcs=$(echo -e "$PT" | grep -w "$pton" | awk '{print $1}' | uniq)
			[[ "$porta" = "$pton" ]] && {
				echo -e "\n\033[1;31mPUERTO \033[1;33m$porta \033[1;31mEN USO POR \033[1;37m$svcs\033[0m"
				sleep 3
				fun_conexao
			}
		done
	}

	slow_setup() {
		[[ -e "/bin/slowdns" ]] && {
			slowdns
		} || {
			cd $HOME
			wget https://raw.githubusercontent.com/rogellevi/SSHPLUS-fixed/main/Slowdns/install -o /dev/null
			chmod 777 install
			./install
		}

	}

	inst_sqd() {
		if netstat -nltp | grep 'squid' 1>/dev/null 2>/dev/null; then
			cabecera "ELIMINAR SQUID PROXY"
			echo ""
			echo -ne "\033[1;32m¿Realmente deseas eliminar Squid? \033[1;33m[s/n]:\033[1;37m "
			read resp
			[[ "$resp" = 's' ]] && {
				echo -e "\n\033[1;32mEliminando Squid Proxy...\033[0m"
				echo ""
				rem_sqd() {
					[[ -d "/etc/squid" ]] && {
						apt-get remove squid -y >/dev/null 2>&1
						apt-get purge squid -y >/dev/null 2>&1
						rm -rf /etc/squid >/dev/null 2>&1
					}
					[[ -d "/etc/squid3" ]] && {
						apt-get remove squid3 -y >/dev/null 2>&1
						apt-get purge squid3 -y >/dev/null 2>&1
						rm -rf /etc/squid3 >/dev/null 2>&1
						apt autoremove -y >/dev/null 2>&1
					}
				}
				fun_bar 'rem_sqd'
				echo -e "\n\033[1;32mSquid eliminado correctamente.\033[0m"
				sleep 2
				clear
				fun_conexao
			} || {
				echo -e "\n\033[1;31mVolviendo...\033[0m"
				sleep 2
				clear
				fun_conexao
			}
		else
			clear
			cabecera "INSTALADOR SQUID"
			echo ""
			IP=$(wget -qO- ipv4.icanhazip.com)
			echo -ne "\033[1;32mPara continuar confirma tu IP: \033[1;37m"
			read -e -i $IP ipdovps
			[[ -z "$ipdovps" ]] && {
				echo -e "\n\033[1;31mIP no válida\033[0m"
				echo ""
				read -p "Ingresa tu IP: " IP
			}
			echo -e "\n\033[1;33m¿Qué puertos deseas utilizar en Squid?"
			echo -e "\n\033[1;33m[\033[1;31m!\033[1;33m] \033[1;32mDefine los puertos en secuencia \033[1;33mEj: \033[1;37m80 8080"
			echo ""
			echo -ne "\033[1;32mIngresa los puertos\033[1;37m: "
			read portass
			[[ -z "$portass" ]] && {
				echo -e "\n\033[1;31m¡Puerto no válido!"
				sleep 3
				fun_conexao
			}
			for porta in $(echo -e $portass); do
				verif_ptrs $porta
			done
			[[ $(grep -wc '14' /etc/issue.net) != '0' ]] || [[ $(grep -wc '8' /etc/issue.net) != '0' ]] && {
				echo -e "\n\033[1;32mInstalando Squid Proxy\033[0m\n"
				fun_bar 'apt update -y' "apt install squid3 -y"
			} || {
				echo -e "\n  \033[1;36m1\033[0m) \033[1;37mSquid versión 3.3.X\n  \033[1;36m2\033[0m) \033[1;37mSquid versión 3.5.X\033[0m\n"
				read -p "$(echo -e "\033[1;32mElige una opción \033[1;37m: ")" -e -i 1 opc
				[[ -z "$opc" ]] && {
					echo -e "\n\033[1;31m¡Opción no válida!"
					sleep 2
					fun_conexao
				}
				[[ "$opc" != '1' ]] && {
					[[ "$opc" != '2' ]] && {
						echo -e "\n\033[1;31m¡Opción no válida!"
						sleep 2
						fun_conexao
					}
				}
				echo -e "\n\033[1;32mInstalando Squid Proxy\033[0m\n"
				fun_bar 'apt update -y' "instsqd $opc"
			}
			if [[ -d "/etc/squid/" ]]; then
				var_sqd="/etc/squid/squid.conf"
				var_pay="/etc/squid/payload.txt"
			elif [[ -d "/etc/squid3/" ]]; then
				var_sqd="/etc/squid3/squid.conf"
				var_pay="/etc/squid3/payload.txt"
			else
				echo -e "\n\033[1;33m[\033[1;31mERROR\033[1;33m]\033[1;37m: \033[1;33mEl Squid Proxy se corrompió\033[0m"
				sleep 2
				fun_conexao
			fi
			cat <<-EOF >$var_pay
				.whatsapp.net/
				.facebook.net/
				.twitter.com/
				.speedtest.net/
			EOF
			cat <<-EOF >$var_sqd
				acl url1 dstdomain -i 127.0.0.1
				acl url2 dstdomain -i localhost
				acl url3 dstdomain -i $ipdovps
				acl url4 dstdomain -i /SSHPLUS?
				acl payload url_regex -i "$var_pay"
				acl all src 0.0.0.0/0

				http_access allow url1
				http_access allow url2
				http_access allow url3
				http_access allow url4
				http_access allow payload
				http_access deny all
				 
				#Portas
			EOF
			for Pts in $(echo -e $portass); do
				echo -e "http_port $Pts" >>$var_sqd
				[[ -f "/usr/sbin/ufw" ]] && ufw allow $Pts/tcp
			done
			cat <<-EOF >>$var_sqd
				#Nombre squid
				visible_hostname SSHPLUS 
				via off
				forwarded_for off
				pipeline_prefetch off
			EOF
			sqd_conf() {
				[[ -d "/etc/squid/" ]] && {
					service ssh restart
					/etc/init.d/squid restart
					service squid restart
				}
				[[ -d "/etc/squid3/" ]] && {
					service ssh restart
					/etc/init.d/squid3 restart
					service squid3 restart
				}
			}
			echo -e "\n\033[1;32mConfigurando Squid Proxy\033[0m"
			echo ""
			fun_bar 'sqd_conf'
			echo -e "\n\033[1;32mSquid instalado correctamente.\033[0m"
			sleep 2.5s
			fun_conexao
		fi
	}

	addpt_sqd() {
		cabecera "AGREGAR PUERTO A SQUID"
		echo -e "\n\033[1;33mPuertos en uso: \033[1;36m$sqdp\n"
		if [[ -f "/etc/squid/squid.conf" ]]; then
			var_sqd="/etc/squid/squid.conf"
		elif [[ -f "/etc/squid3/squid.conf" ]]; then
			var_sqd="/etc/squid3/squid.conf"
		else
			echo -e "\n\033[1;31m¡Squid no está instalado!\033[0m"
			echo -e "\n\033[1;31mVolviendo...\033[0m"
			sleep 2
			clear
			fun_squid
		fi
		echo -ne "\033[1;32m¿Qué puerto deseas agregar?\033[1;37m "
		read pt
		[[ -z "$pt" ]] && {
			echo -e "\n\033[1;31m¡Puerto no válido!"
			sleep 2
			clear
			fun_conexao
		}
		verif_ptrs $pt
		echo -e "\n\033[1;32mAgregando puerto a Squid..."
		echo ""
		sed -i "s/#Portas/#Portas\nhttp_port $pt/g" $var_sqd
		fun_bar 'sleep 2'
		echo -e "\n\033[1;32mReiniciando Squid!"
		echo ""
		fun_bar 'service squid restart' 'service squid3 restart'
		echo -e "\n\033[1;32m¡Puerto agregado correctamente!"
		sleep 3
		clear
		fun_squid
	}

	rempt_sqd() {
		cabecera "ELIMINAR PUERTO DE SQUID"
		echo -e "\n\033[1;33mPuertos en uso: \033[1;36m$sqdp\n"
		if [[ -f "/etc/squid/squid.conf" ]]; then
			var_sqd="/etc/squid/squid.conf"
		elif [[ -f "/etc/squid3/squid.conf" ]]; then
			var_sqd="/etc/squid3/squid.conf"
		else
			echo -e "\n\033[1;31m¡Squid no está instalado!\033[0m"
			echo -e "\n\033[1;31mVolviendo...\033[0m"
			sleep 2
			clear
			fun_squid
		fi
		echo -ne "\033[1;32m¿Qué puerto deseas eliminar?\033[1;37m "
		read pt
		[[ -z "$pt" ]] && {
			echo -e "\n\033[1;31m¡Puerto no válido!"
			sleep 2
			clear
			fun_conexao
		}
		if grep -E "$pt" $var_sqd >/dev/null 2>&1; then
			echo -e "\n\033[1;32mEliminando puerto de Squid!"
			echo ""
			sed -i "/http_port $pt/d" $var_sqd
			fun_bar 'sleep 3'
			echo -e "\n\033[1;32mReiniciando Squid!"
			echo ""
			fun_bar 'service squid restart' 'service squid3 restart'
			echo -e "\n\033[1;32mPuerto eliminado correctamente!"
			sleep 3.5s
			clear
			fun_squid
		else
			echo -e "\n\033[1;31mPUERTO \033[1;32m$pt \033[1;31mNO ENCONTRADO!"
			sleep 3.5s
			clear
			fun_squid
		fi
	}

	fun_squid() {
		[[ "$(netstat -nplt | grep -c 'squid')" = "0" ]] && inst_sqd
		cabecera "ADMINISTRAR SQUID PROXY"
		[[ "$(netstat -nplt | grep -c 'squid')" != "0" ]] && {
			sqdp=$(netstat -nplt | grep 'squid' | awk -F ":" {'print $4'} | xargs)
			echo -e "\n\033[1;33mPuertos\033[1;37m: \033[1;36m$sqdp"
			VarSqdOn="Eliminar Squid Proxy"
		} || {
			VarSqdOn="Instalar Squid Proxy"
		}
		echo -e "\n  \033[1;36m1\033[0m) \033[1;37m$VarSqdOn 
  \033[1;36m2\033[0m) \033[1;37mAgregar puerto 
  \033[1;36m3\033[0m) \033[1;37mEliminar puerto
  \033[1;36m0\033[0m) \033[1;37mVolver\033[0m"
		echo ""
		echo -ne "  \033[1;32mSelecciona una opción:\033[0m "
		read x
		clear
		case $x in
		1 | 01)
			inst_sqd
			;;
		2 | 02)
			addpt_sqd
			;;
		3 | 03)
			rempt_sqd
			;;
		0 | 00)
			echo -e "\033[1;31mVolviendo...\033[0m"
			sleep 1
			fun_conexao
			;;
		*)
			echo -e "\033[1;31m¡Opción no válida!\033[0m"
			sleep 2
			fun_conexao
			;;
		esac
	}

	fun_drop() {
		if netstat -nltp | grep 'dropbear' 1>/dev/null 2>/dev/null; then
			clear
			[[ $(netstat -nltp | grep -c 'dropbear') != '0' ]] && dpbr=$(netstat -nplt | grep 'dropbear' | awk -F ":" {'print $4'} | xargs) || sqdp="\033[1;31mNo disponible"
			if ps x | grep "limiter" | grep -v grep 1>/dev/null 2>/dev/null; then
				stats='\033[1;32m◉ '
			else
				stats='\033[1;31m○ '
			fi
			cabecera "ADMINISTRAR DROPBEAR"
			echo -e "\n\033[1;33mPuertos\033[1;37m: \033[1;36m$dpbr"
			echo ""
			echo -e "  \033[1;36m1\033[0m) \033[1;37mLimiter Dropbear $stats\033[0m"
			echo -e "  \033[1;36m2\033[0m) \033[1;37mModificar puerto Dropbear\033[0m"
			echo -e "  \033[1;36m3\033[0m) \033[1;37mEliminar Dropbear\033[0m"
			echo -e "  \033[1;36m0\033[0m) \033[1;37mVolver\033[0m"
			echo ""
			echo -ne "  \033[1;32mSelecciona una opción:\033[0m "
			read resposta
			if [[ "$resposta" = '1' ]]; then
				clear
				if ps x | grep "limiter" | grep -v grep 1>/dev/null 2>/dev/null; then
					echo -e "\033[1;32mDeteniendo el limiter... \033[0m"
					echo ""
					fun_stplimiter() {
						pidlimiter=$(ps x | grep "limiter" | awk -F "pts" {'print $1'})
						kill -9 $pidlimiter
						screen -wipe
					}
					fun_bar 'fun_stplimiter' 'sleep 2'
					echo -e "\n\033[1;31m Limiter desactivado \033[0m"
					sleep 3
					fun_drop
				else
					echo -e "\n\033[1;32mIniciando el limiter... \033[0m"
					echo ""
					fun_bar 'screen -d -m -t limiter droplimiter' 'sleep 3'
					echo -e "\n\033[1;32m  Limiter activado \033[0m"
					sleep 3
					fun_drop
				fi
			elif [[ "$resposta" = '2' ]]; then
				echo ""
				echo -ne "\033[1;32m¿Qué puerto quieres usar?\033[1;37m "
				read pt
				echo ""
				verif_ptrs $pt
				var1=$(grep 'DROPBEAR_PORT=' /etc/default/dropbear | cut -d'=' -f2)
				echo -e "\033[1;32mModificando PUERTO DROPBEAR!"
				sed -i "s/\b$var1\b/$pt/g" /etc/default/dropbear >/dev/null 2>&1
				echo ""
				fun_bar 'sleep 2'
				echo -e "\n\033[1;32mReiniciando Dropbear!"
				echo ""
				fun_bar 'service dropbear restart' '/etc/init.d/dropbear restart'
				echo -e "\n\033[1;32mPuerto cambiado correctamente!"
				sleep 3
				clear
				fun_conexao
			elif [[ "$resposta" = '3' ]]; then
				echo -e "\n\033[1;32mEliminando Dropbear...\033[0m"
				echo ""
				fun_dropunistall() {
					service dropbear stop && /etc/init.d/dropbear stop
					apt-get autoremove dropbear -y
					apt-get remove dropbear-run -y
					apt-get remove dropbear -y
					apt-get purge dropbear -y
					rm -rf /etc/default/dropbear
				}
				fun_bar 'fun_dropunistall'
				echo -e "\n\033[1;32mDropbear eliminado correctamente.\033[0m"
				sleep 3
				clear
				fun_conexao
			elif [[ "$resposta" = '0' ]]; then
				echo -e "\n\033[1;31mVolviendo...\033[0m"
				sleep 2
				fun_conexao
			else
				echo -e "\n\033[1;31m¡Opción no válida!\033[0m"
				sleep 2
				fun_conexao
			fi
		else
			clear
			cabecera "INSTALADOR DROPBEAR"
			echo -e "\n\033[1;33m¡Estás a punto de instalar Dropbear!\033[0m\n"
			echo -ne "\033[1;32m¿Deseas continuar? \033[1;33m[s/n]:\033[1;37m "
			read resposta
			[[ "$resposta" = 's' ]] && {
				echo -e "\n\033[1;33mDefine un puerto para Dropbear\033[0m\n"
				echo -ne "\033[1;32m¿Qué puerto quieres usar?\033[1;37m "
				read porta
				[[ -z "$porta" ]] && {
					echo -e "\n\033[1;31m¡Puerto no válido!"
					sleep 3
					clear
					fun_conexao
				}
				verif_ptrs $porta
				echo -e "\n\033[1;32mInstalando  DROPBEAR ! \033[0m"
				echo ""
				fun_instdrop() {
					apt-get update -y
					apt-get install dropbear -y
				}
				fun_bar 'fun_instdrop'
				fun_ports() {
					sed -i 's/NO_START=1/NO_START=0/g' /etc/default/dropbear >/dev/null 2>&1
					sed -i "s/DROPBEAR_PORT=22/DROPBEAR_PORT=$porta/g" /etc/default/dropbear >/dev/null 2>&1
					sed -i 's/DROPBEAR_EXTRA_ARGS=/DROPBEAR_EXTRA_ARGS="-p 110"/g' /etc/default/dropbear >/dev/null 2>&1
				}
				echo ""
				echo -e "\033[1;32mConfigurando PUERTO DROPBEAR !\033[0m"
				echo ""
				fun_bar 'fun_ports'
				grep -v "^PasswordAuthentication yes" /etc/ssh/sshd_config >/tmp/passlogin && mv /tmp/passlogin /etc/ssh/sshd_config
				echo "PasswordAuthentication yes" >>/etc/ssh/sshd_config
				grep -v "^PermitTunnel yes" /etc/ssh/sshd_config >/tmp/ssh && mv /tmp/ssh /etc/ssh/sshd_config
				echo "PermitTunnel yes" >>/etc/ssh/sshd_config
				echo ""
				echo -e "\033[1;32mFinalizando instalación...\033[0m"
				echo ""
				fun_ondrop() {
					service dropbear start
					/etc/init.d/dropbear restart
				}
				fun_bar 'fun_ondrop' 'sleep 1'
				echo -e "\n\033[1;32minstalación CONCLUIDA \033[1;33mPuerto: \033[1;37m$porta\033[0m"
				[[ $(grep -c "/bin/false" /etc/shells) = '0' ]] && echo "/bin/false" >>/etc/shells
				sleep 2
				clear
				fun_conexao
			} || {
				echo ""
				echo -e "\033[1;31mVolviendo...\033[0m"
				sleep 3
				clear
				fun_conexao
			}
		fi
	}
	fun_v2rayins() {
		clear
		v2rayinst() {
			source <(curl -sL https://raw.githubusercontent.com/rogellevi/SSHPLUS-fixed/main/Modulos/v2ray)
			sleep 6
		}
		if netstat -tunlp | grep v2ray 1>/dev/null 2>/dev/null; then
			cabecera "INSTALADOR V2RAY"
			echo -e "\n${YELLOW}V2Ray ya está instalado\n¿Deseas reinstalar? ${SCOLOR}\n"
			echo -ne "${GREEN}¿Deseas continuar con la reinstalación? ${YELLOW}[s/n]:${SCOLOR} "
			read resp
			[[ "$resp" != @(s|sim|S|SIM) ]] && {
				echo -e "\n${RED}Volviendo...${SCOLOR}"
				sleep 2
				conexao
			}
			v2rayinst
		else
			cabecera "INSTALADOR V2RAY"
			echo -e "\n${YELLOW}Ten en cuenta que este método es inestable.\nConoce los riesgos antes de continuar. ${SCOLOR}\n"
			echo -ne "${GREEN}¿Deseas continuar con la instalación? ${YELLOW}[s/n]:${SCOLOR} "
			read resp
			[[ "$resp" != @(s|sim|S|SIM) ]] && {
				echo -e "\n${RED}Volviendo...${SCOLOR}"
				sleep 2
				conexao
			}
			v2rayinst
		fi
	}
	fun_chisel() {
		clear
		cabecera "ADMINISTAR CHISEL"
		echo ""

		[[ "$(netstat -tlpn | grep 'docker' | wc -l)" != '0' ]] && {
			sks='\033[1;32mON'
			echo -e "\033[1;33mPuertos\033[1;37m: \033[1;36m$(netstat -nplt | grep 'docker' | awk {'print $4'} | cut -d: -f2 | xargs)"
		} || {
			sks='\033[1;31mOFF'
		}
		[[ "$(netstat -tlpn | grep 'docker' | wc -l)" != '0' ]] && {
			chiselsts="\033[1;32m◉ "
		} || {
			chiselsts="\033[1;31m○ "
		}
		echo ""
		echo -e "  \033[1;36m1\033[0m) \033[1;37mActivar Chisel $chiselsts \033[0m"
		echo -e "  \033[1;36m2\033[0m) \033[1;37mReiniciar Chisel\033[0m"
		echo -e "  \033[1;36m0\033[0m) \033[1;37mVolver\033[0m"
		echo ""
		echo -ne "  \033[1;32mSelecciona una opción:\033[0m "
