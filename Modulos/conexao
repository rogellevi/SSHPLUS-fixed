	inst_ssl() {
    # ─── Funciones auxiliares para manejo de puertos SSL ───
    add_ssl_port() {
        local puerto="$1"
        local destino="$2"
        local conf="/etc/stunnel/stunnel.conf"

        if grep -qE "accept[ \t]*=[ \t]*${puerto}\b" "$conf" 2>/dev/null; then
            echo -e "\n  \033[1;31mEl puerto $puerto ya está configurado.\033[0m"
            return 1
        fi

        local n=1
        while grep -q "^\[stunnel${n}\]" "$conf" 2>/dev/null; do
            n=$((n + 1))
        done

        {
            echo ""
            echo "[stunnel${n}]"
            echo "connect = 127.0.0.1:${destino}"
            echo "accept = ${puerto}"
        } >> "$conf"

        echo -e "\n  \033[1;32m✓ Puerto $puerto agregado (stunnel${n} → ${destino}).\033[0m"
        return 0
    }

    list_ssl_ports() {
        grep -E "^accept" /etc/stunnel/stunnel.conf 2>/dev/null | awk '{print $3}' | xargs
    }

    del_ssl_port() {
        local puerto="$1"
        local conf="/etc/stunnel/stunnel.conf"
        local tmp
        tmp=$(mktemp)

        awk -v p="$puerto" '
            /^\[stunnel[0-9]+\]/ { inblock=1; block=$0 ORS; next }
            inblock {
                block = block $0 ORS
                if ($0 ~ /^accept[ \t]*=/) {
                    if ($3 == p) { inblock=0; block=""; next }
                    else { printf "%s", block; inblock=0; block="" }
                }
                next
            }
            { print }
        ' "$conf" > "$tmp" && mv "$tmp" "$conf"
    }

    # ─── Fin auxiliares ───

    if netstat -nltp | grep 'stunnel4' 1>/dev/null 2>/dev/null; then
        [[ $(netstat -nltp | grep 'stunnel4' | wc -l) != '0' ]] && sslt=$(netstat -nplt | grep stunnel4 | awk {'print $4'} | awk -F ":" {'print $2'} | xargs) || sslt="\033[1;31mNo disponible"
        cabecera "ADMINISTAR SSL TUNNEL"
        echo -e "\n\033[1;33mPuertos\033[1;37m: \033[1;36m$sslt"
        echo ""
        echo -e "  \033[1;36m1\033[0m) \033[1;37mModificar puerto SSL Tunnel\033[0m"
        echo -e "  \033[1;36m2\033[0m) \033[1;37mEliminar SSL Tunnel\033[0m"
        echo -e "  \033[1;36m0\033[0m) \033[1;37mVolver\033[0m"
        echo ""
        echo -ne "  \033[1;32mSelecciona una opción:\033[0m "
        read resposta
        echo ""
        [[ "$resposta" = '1' ]] && {
            echo ""
            echo -e "\033[1;36m  1\033[0m) \033[1;37m• \033[1;33mAgregar puerto SSL\033[0m"
            echo -e "\033[1;36m  2\033[0m) \033[1;37m• \033[1;33mEliminar puerto SSL\033[0m"
            echo -e "\033[1;36m  0\033[0m) \033[1;37m• \033[1;33mVolver\033[0m"
            echo ""
            echo -ne "  \033[1;32mOpción:\033[0m "
            read opc2
            if [[ "$opc2" = '1' ]]; then
                echo ""
                echo -ne "\033[1;32m¿Qué puerto quieres agregar? \033[1;37m"
                read porta
                [[ -z "$porta" ]] && {
                    echo ""
                    echo -e "\033[1;31m¡Puerto no válido!"
                    sleep 2
                    clear
                    fun_conexao
                }
                verif_ptrs "$porta"
                echo -ne "\033[1;32m¿Destino del túnel? [22=SSH / 80=Web] \033[1;37m"
                read destino
                [[ -z "$destino" ]] && destino="22"
                add_ssl_port "$porta" "$destino"
                echo ""
                echo -e "\033[1;32mReiniciando SSL TUNNEL...\033[0m"
                fun_bar 'service stunnel4 restart' '/etc/init.d/stunnel4 restart'
                netstat -nltp | grep 'stunnel4' >/dev/null \
                    && echo -e "\n\033[1;32m✓ Puertos activos: \033[1;33m$(list_ssl_ports)\033[0m" \
                    || echo -e "\n\033[1;31mERROR inesperado!"
                sleep 3
                clear
                fun_conexao
            elif [[ "$opc2" = '2' ]]; then
                echo ""
                echo -e "\033[1;33mPuertos actuales:\033[0m \033[1;36m$(list_ssl_ports)\033[0m"
                echo ""
                echo -ne "\033[1;32m¿Qué puerto quieres eliminar? \033[1;37m"
                read porta
                [[ -z "$porta" ]] && {
                    echo ""
                    echo -e "\033[1;31m¡Puerto no válido!"
                    sleep 2
                    clear
                    fun_conexao
                }
                del_ssl_port "$porta"
                echo ""
                echo -e "\033[1;32mReiniciando SSL TUNNEL...\033[0m"
                fun_bar 'service stunnel4 restart' '/etc/init.d/stunnel4 restart'
                echo -e "\n\033[1;32m✓ Puertos activos: \033[1;33m$(list_ssl_ports)\033[0m"
                sleep 3
                clear
                fun_conexao
            else
                clear
                fun_conexao
            fi
        }
        [[ "$resposta" = '2' ]] && {
            echo -e "\033[1;32mEliminando   SSL TUNNEL !\033[0m"
            del_ssl() {
                service stunnel4 stop
                apt-get remove stunnel4 -y
                apt-get autoremove stunnel4 -y
                apt-get purge stunnel4 -y
                rm -rf /etc/stunnel/stunnel.conf
                rm -rf /etc/default/stunnel4
                rm -rf /etc/stunnel/cert.cert
                rm -rf /etc/stunnel/key.key
            }
            echo ""
            fun_bar 'del_ssl'
            echo ""
            echo -e "\033[1;32mSSL TUNNEL ELIMINADO correctamente!\033[0m"
            sleep 3
            fun_conexao
        }
    else
        clear
        cabecera "INSTALAR SSL TUNNEL"
        echo ""
        echo -e "  \033[1;36m1\033[0m) \033[1;37mInstalar SSL Tunnel estándar\033[0m"
        echo -e "  \033[1;36m2\033[0m) \033[1;37mInstalar SSL Tunnel WebSocket\033[0m"
        echo -e "  \033[1;36m0\033[0m) \033[1;37mVolver\033[0m"
        echo ""
        echo -ne "  \033[1;32mSelecciona una opción:\033[0m "
        read resposta
        echo ""
        if [[ "$resposta" = '1' ]]; then
            portssl='22'
        elif [[ "$resposta" = '2' ]]; then
            portssl='80'
        elif [[ "$resposta" = '0' ]]; then
            echo -e "\033[1;31mVolviendo...\033[0m"
            sleep 3
            fun_conexao
        else
            echo ""
            echo -e "\033[1;31m¡Opción no válida!\033[0m"
            sleep 1
            inst_ssl
        fi
        clear
        cabecera "INSTALADOR SSL TUNNEL"
        echo -e "\n\033[1;33m¡Estás a punto de instalar SSL Tunnel!\033[0m"
        echo ""
        echo -ne "\033[1;32m¿Deseas continuar? \033[1;33m[s/n]:\033[1;37m "
        read resposta
        [[ "$resposta" = 's' ]] && {
            echo -e "\n\033[1;33mDefine un puerto para SSL Tunnel\033[0m"
            echo ""
            echo -ne "\033[1;32m¿Qué puerto deseas utilizar? \033[1;37m"
            read porta
            [[ -z "$porta" ]] && porta="443"
            [[ -z "$porta" ]] && {
                echo ""
                echo -e "\033[1;31m¡Puerto no válido!"
                sleep 3
                clear
                fun_conexao
            }
            verif_ptrs $porta
            echo -e "\n\033[1;32mInstalando  SSL TUNNEL !\033[0m"
            echo ""
            fun_bar 'apt-get update -y' 'apt-get install stunnel4 -y'
            echo -e "\n\033[1;32mConfigurando SSL Tunnel...\033[0m"
            echo ""
            ssl_conf() {
                cat > /etc/stunnel/stunnel.conf <<EOF
cert = /etc/stunnel/stunnel.pem
client = no
socket = a:SO_REUSEADDR=1
socket = l:TCP_NODELAY=1
socket = r:TCP_NODELAY=1
EOF
                add_ssl_port "${porta}" "${portssl}"
            }
            fun_bar 'ssl_conf'
            echo -e "\n\033[1;32mCreando certificado...\033[0m"
            echo ""
            ssl_certif() {
                crt='EC'
                openssl genrsa -out key.pem 2048 >/dev/null 2>&1
                (
                    echo $crt
                    echo $crt
                    echo $crt
                    echo $crt
                    echo $crt
                    echo $crt
                    echo $crt
                ) | openssl req -new -x509 -key key.pem -out cert.pem -days 1050 >/dev/null 2>&1
                cat cert.pem key.pem >>/etc/stunnel/stunnel.pem
                rm key.pem cert.pem >/dev/null 2>&1
                sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/stunnel4
            }
            fun_bar 'ssl_certif'
            echo -e "\n\033[1;32mINICIANDO SSL TUNNEL !\033[0m"
            echo ""
            fun_finssl() {
                service stunnel4 restart
                service ssh restart
                /etc/init.d/stunnel4 restart
            }
            fun_bar 'fun_finssl' 'service stunnel4 restart'
            echo -e "\n\033[1;32mSSL TUNNEL Instalado correctamente.\033[1;31m Puerto: \033[1;33m$porta\033[0m"
            sleep 1
            clear
            echo -e "Corrigiendo SSL Claro"
            cd /etc/stunnel/
            rm -rf stunnel.conf
            rm -rf stunnel.pem
            wget https://raw.githubusercontent.com/rogellevi/SSHPLUS-fixed/master/Install/cert
            wget https://raw.githubusercontent.com/rogellevi/SSHPLUS-fixed/master/Install/key
            wget https://raw.githubusercontent.com/rogellevi/SSHPLUS-fixed/master/Install/stunnel
            mv cert cert.pem
            mv key key.pem
            mv stunnel stunnel.conf
            chmod 777 cert.pem
            chmod 777 key.pem
            chmod 777 stunnel.conf
            service stunnel4 restart
            cd $HOME
            clear
            echo -e "Corregido"
            sleep 2
            fun_conexao
        } || {
            echo -e "\n\033[1;31mVolviendo...\033[0m"
            sleep 2
            clear
            fun_conexao
        }
    fi
}

	fun_openvpn() {
		if readlink /proc/$$/exe | grep -qs "dash"; then
			echo "Este script debe ejecutarse con bash, no con sh"
