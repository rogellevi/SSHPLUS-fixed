    echo -e "\033[0;34m╔══════════════════════════════════════════════════╗\033[0m"
    echo -e "\033[0;34m║\033[0m\033[1;37m         \033[1;32m✓ INSTALACIÓN TERMINADA\033[1;37m                  \033[0;34m║\033[0m"
    echo -e "\033[0;34m╚══════════════════════════════════════════════════╝\033[0m"
    echo ""
    echo -e "  \033[1;33mComando principal:\033[0m \033[1;32mmenu\033[0m"
    echo -e "  \033[1;33mMás información (Telegram):\033[0m \033[1;37m@SSHPLUS\033[0m"
    echo ""
    rm -f $HOME/Plus >/dev/null 2>&1
    cat /dev/null >~/.bash_history && history -c

# ═══════════════════════════════════════════════════
#  ARM (aarch64)
# ═══════════════════════════════════════════════════
